                    <button type="button" class="btn-close" @onclick="() => showInviteModal = false"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Registered User Email</label>
                    <input type="email" class="form-control" @bind="inviteEmail" placeholder="colleague@domain.com" />
                    <small class="text-muted">The user must have an existing account on CollabSpace.</small>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showInviteModal = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="SendInvite">Send Invitation</button>
                </div>
            </div>
        </div>
    </div>
