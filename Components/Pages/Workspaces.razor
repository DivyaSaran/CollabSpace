@code {
    private List<WorkspaceItem>? myWorkspaces;
    private WorkspaceItem? selectedWorkspace;
    private List<MemberItem>? workspaceMembers;
    private List<InviteItem>? pendingInvites;

    private bool showCreateModal = false;
    private bool showInviteModal = false;
    private string newWsName = string.Empty;
    private string newWsDescription = string.Empty;
    private string inviteEmail = string.Empty;

    private string? statusMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        try
        {
            myWorkspaces = await Http.GetFromJsonAsync<List<WorkspaceItem>>("api/Workspaces/my-workspaces");
            pendingInvites = await Http.GetFromJsonAsync<List<InviteItem>>("api/Workspaces/invites/my-invites");

            if (myWorkspaces != null && myWorkspaces.Any() && selectedWorkspace == null)
            {
                await SelectWorkspace(myWorkspaces.First());
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading workspaces: {ex.Message}";
        }
    }

    private async Task SelectWorkspace(WorkspaceItem ws)
    {
        selectedWorkspace = ws;
        workspaceMembers = null;
        try
        {
            workspaceMembers = await Http.GetFromJsonAsync<List<MemberItem>>($"api/Workspaces/{ws.Id}/members");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading members: {ex.Message}";
        }
    }

    private async Task CreateWorkspace()
    {
        statusMessage = null;
        errorMessage = null;

        var payload = new { Name = newWsName, Description = newWsDescription };
        var res = await Http.PostAsJsonAsync("api/Workspaces", payload);

        if (res.IsSuccessStatusCode)
        {
            statusMessage = "Workspace created successfully.";
            showCreateModal = false;
            newWsName = string.Empty;
            newWsDescription = string.Empty;
            await LoadInitialData();
        }
        else
        {
            var err = await res.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            errorMessage = err != null && err.TryGetValue("message", out var msg) ? msg : "Failed to create workspace.";
        }
    }

    private async Task SendInvite()
    {
        if (selectedWorkspace == null) return;
        statusMessage = null;
        errorMessage = null;

        var payload = new { ReceiverEmail = inviteEmail };
        var res = await Http.PostAsJsonAsync($"api/Workspaces/{selectedWorkspace.Id}/invite", payload);

        if (res.IsSuccessStatusCode)
        {
            statusMessage = $"Invitation successfully sent to {inviteEmail}.";
            showInviteModal = false;
            inviteEmail = string.Empty;
        }
        else
        {
            var err = await res.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            errorMessage = err != null && err.TryGetValue("message", out var msg) ? msg : "Failed to send invitation.";
        }
    }

    private async Task RespondInvite(int inviteId, bool accept)
    {
        statusMessage = null;
        errorMessage = null;

        var res = await Http.PostAsJsonAsync($"api/Workspaces/invites/{inviteId}/respond", new { Accept = accept });

        if (res.IsSuccessStatusCode)
        {
            statusMessage = accept ? "Workspace invitation accepted." : "Workspace invitation declined.";
            await LoadInitialData();
        }
        else
        {
            errorMessage = "Failed to process invitation.";
        }
    }

