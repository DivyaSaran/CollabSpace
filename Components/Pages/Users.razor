@page "/users"
@using CollabSpace.Models
@inject HttpClient Http

<PageTitle>CollabSpace Users</PageTitle>

<h3>Users Data Directory</h3>

<!-- Fetch single user by ID-->

<div class=" card mb-4 p-3 bg-light-subtle">
    <h5>Search User by Id</h5>

    <div class=" row g-2 align-items-center">

        <div class="col-auto">
            <input type="number" class="form-control" placeholder="Enter User ID" @bind="searchId" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="GetUserById">Search</button>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-secondary" @onclick="LoadAllUsers">Clear / Show All</button>
        </div>

    </div>

    <!-- Error/Warning Message -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-warning mt-3 mb-0" role="alert">
            @errorMessage
        </div>
    }

    <!-- Single User Result -->
    @if (searchedUser != null)
    {
        <div class="card mt-3 border-info">
            <div class="card-body">
                <h6 class="card-title fw-bold">User Found:</h6>
                <p class="card-text mb-1"><strong>ID:</strong> @searchedUser.Id</p>
                <p class="card-text mb-1"><strong>Name:</strong> @searchedUser.Name</p>
                <p class="card-text mb-1"><strong>Username:</strong> @searchedUser.Username</p>
                <p class="card-text mb-0"><strong>Email:</strong> @searchedUser.Email</p>
            </div>
        </div>
    }
</div>

<!-- List All Users -->
<h5 class="mt-4">All Users</h5>

@if (users == null)
{
    <p><em>Loading users...</em></p>
}
else if (!users.Any())
{
    <p class="text-muted">No users found in the database.</p>
}
else
{
    <table class="table table-striped table-hover mt-2">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Username</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                </tr>
            }
        </tbody>
    </table>
}
<!-- Create New User (POST) -->
<div class="card mb-4 p-3 bg-light border-primary">
    <h5>Add New User</h5>
    <EditForm Model="newUser" OnValidSubmit="CreateUser">
        <DataAnnotationsValidator />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="newUser.Name" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Username</label>
                <InputText class="form-control" @bind-Value="newUser.Username" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="newUser.Email" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Password</label>
                <InputText class="form-control" @bind-Value="newUser.Password" required />
            </div>
        </div>

        <button type="submit" class="btn btn-success mt-3">Add User</button>
    </EditForm>
</div>

@code {
    private List<User>? users;
    private User? searchedUser;
    private int? searchId;
    private string? errorMessage;
    private User newUser = new();
    private string? statusMessage;

    // Runs automatically when the component loads
    protected override async Task OnInitializedAsync()
    {
        await LoadAllUsers();
    }

    // Call Endpoint : GET /api/Users
    private async Task LoadAllUsers()
    {        

        try
        {
            users = await Http.GetFromJsonAsync<List<User>>("api/Users");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading users: {ex.Message}";
        }
    }

    // Call Endpoint : GET /api/Users/{id}
    private async Task GetUserById()
    {
        errorMessage = null;
        searchedUser = null;

        if (!searchId.HasValue || searchId <= 0)
        {
            errorMessage = "Please enter a valid User ID.";
            return;
        }

        var response = await Http.GetAsync($"api/Users/{searchId.Value}");

        if (response.IsSuccessStatusCode)
        {
            searchedUser = await response.Content.ReadFromJsonAsync<User>();
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            errorMessage = $"User with ID {searchId.Value} was not found.";
        }
        else
        {
            errorMessage = $"Failed to retrieve user (Status: {response.StatusCode}).";
        }
    }

    //Call Endpoint : POSt /api/users
    private async Task CreateUser()
    {
        statusMessage = null;

        // Sends a POST request with JSON payload
        var response = await Http.PostAsJsonAsync("api/Users", newUser);

        if (response.IsSuccessStatusCode)
        {
            statusMessage = "User added successfully!";
            newUser = new User(); // Reset the form fields
            await LoadAllUsers(); // Refresh the table automatically
        }
        else
        {
            statusMessage = $"Failed to add user. (Status: {response.StatusCode})";
        }
    }
}


