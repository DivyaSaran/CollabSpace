<h3>ForgotPassword</h3>

@page "/forgot-password"
@using CollabSpace.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager

<PageTitle>CollabSpace - Forgot Password</PageTitle>

<div class="container mt-5" style="max-width: 460px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white text-center py-3">
            <h4 class="mb-0 fw-bold">Reset Password</h4>
        </div>
        <div class="card-body p-4">
            <p class="text-muted small mb-3">
                Enter your registered email address and we will generate a password reset link.
            </p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2 small">@errorMessage</div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success py-2 small">
                    <div>@successMessage</div>
                    @if (!string.IsNullOrEmpty(devResetLink))
                    {
                        <hr class="my-2" />
                        <div class="fw-semibold mb-1">Development Reset Link:</div>
                        <a href="@devResetLink" class="btn btn-sm btn-outline-success w-100 mt-1">
                            Click Here to Reset Password
                        </a>
                    }
                </div>
            }

            <EditForm Model="@model" OnValidSubmit="HandleForgotPassword">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText type="email" class="form-control" @bind-Value="model.Email" placeholder="name@domain.com" />
                    <ValidationMessage For="@(() => model.Email)" class="text-danger small" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
                    @(isSubmitting ? "Generating Link..." : "Send Reset Link")
                </button>
            </EditForm>

            <div class="text-center mt-3">
                <a href="login" class="small text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordDto model = new();
    private bool isSubmitting = false;
    private string? successMessage;
    private string? errorMessage;
    private string? devResetLink;

    private async Task HandleForgotPassword()
    {
        isSubmitting = true;
        errorMessage = null;
        successMessage = null;
        devResetLink = null;

        try
        {
            var baseUri = NavManager.BaseUri.TrimEnd('/');
            var response = await Http.PostAsJsonAsync($"{baseUri}/api/auth/forgot-password", model);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ForgotPasswordResponse>();
                successMessage = result?.Message ?? "Reset link generated.";
                devResetLink = result?.ResetLink;
            }
            else
            {
                errorMessage = "Unable to process password reset request.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class ForgotPasswordResponse
    {
        public string? Message { get; set; }
        public string? ResetLink { get; set; }
    }
}
