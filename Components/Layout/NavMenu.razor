@inject HttpClient Http
@inject NavigationManager NavManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CollabSpace</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <!-- Visible only to logged-in users -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="users">
                        <i class="bi bi-people-fill me-3" style="line-height: 1; font-size: 1.1rem;" aria-hidden="true"></i>
                        <span>CollabSpace Users</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="workspaces">
                        <i class="bi bi-kanban-fill me-3" style="line-height: 1; font-size: 1.1rem;" aria-hidden="true"></i>
                        <span>Workspaces</span>
                    </NavLink>
                </div>

                <!-- User profile badge (reads DisplayName & Email claims) & logout -->
                <div class="nav-item px-3 mt-3 border-top border-secondary pt-2">
                    <div class="px-3 py-1 text-white">
                        <small class="text-white-50 d-block">Signed in as:</small>
                        <strong class="d-block text-truncate">
                            @(context.User.FindFirst("DisplayName")?.Value ?? context.User.Identity?.Name)
                        </strong>
                        <small class="text-white-50 d-block text-truncate" style="font-size: 0.75rem;">
                            @context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                        </small>
                    </div>

                    <AuthorizeView Roles="Admin" Context="adminContext">
                        <div class="nav-item px-3 mt-1">
                            <NavLink class="nav-link d-flex align-items-center" href="roles" Match="NavLinkMatch.Prefix">
                                <i class="bi bi-shield-lock-fill me-3" style="line-height: 1; font-size: 1.1rem;" aria-hidden="true"></i>
                                <span>Role Management</span>
                            </NavLink>
                        </div>
                    </AuthorizeView>

                    <div class="px-3 mt-2">
                        <button class="btn btn-sm btn-danger w-100 fw-semibold" @onclick="HandleLogout">
                            <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                        </button>
                    </div>
                </div>
            </Authorized>

            <NotAuthorized>
                <!-- Visible only to guests -->
                <div class="nav-item px-3 mt-2">
                    <NavLink class="nav-link d-flex align-items-center" href="login">
                        <i class="bi bi-box-arrow-in-right me-3" style="line-height: 1; font-size: 1.1rem;" aria-hidden="true"></i>
                        <span>Login</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="login?mode=register">
                        <i class="bi bi-person-plus-fill me-3" style="line-height: 1; font-size: 1.1rem;" aria-hidden="true"></i>
                        <span>Register</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private async Task HandleLogout()
    {
        await Http.PostAsync("api/Auth/logout", null);
        NavManager.NavigateTo("/login", forceLoad: true);
    }
}